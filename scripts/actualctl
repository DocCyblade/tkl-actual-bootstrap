#!/usr/bin/env bash
# ==============================================================================
# tkl-actual-bootstrap : scripts/actualctl
# Version: v1.0.0-rc1
# Script-Version : v1.10.5
# Packaged-In    : v1.0.0-rc1
# Package-Compat : >=v1.0.0-rc1 <v1.1.0
# Last-Reviewed  : 2025-09-28 with package v1.0.0-rc1
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Summary:
#   Ops CLI for managing Actual multi-instance installs on TurnKey Linux:
#   list/check/health/doctor, fetch/switch/verify versions, backups,
#   add/rm/set-port instances, and service/log helpers.
#
# Changes since v0.23.3:
#   - v1.10.5: add prune-versions to clean unused app versions; supports --dry-run, --keep N, --older-than DAYS.
#   - Dynamic versioning: --version now prints "script <Script-Version> (package <PKG_VERSION>)"
#   - Doctor remediation: new 'doctor --fix' installs/refreshes the system VERSION manifest
#   - Docs: updated usage/help text
#   - v1.10.4: banner defaults to ASCII; opt-in UTF-8 line when USE_UTF8_BANNER=1; still respects NO_COLOR and TTY only.
#   - v1.10.3: verify trap is nounset-safe; accepts 'v'-prefixed versions (strips 'v' for npm install).
#
# License: GNU GPL v3
# Author : Ken Robinson <ken@turnkeylinux.org>
# Source : https://github.com/DocCyblade/tkl-actual-bootstrap
#
# Usage: actualctl --help
# ==============================================================================


set -Eeuo pipefail

# --- dynamic version helpers (do not remove) ---
__tklab_read_version_file() {
  local f v=""
  for f in "${TKL_ACTUAL_VERSION_FILE:-}" \
           "/usr/share/tkl-actual-bootstrap/VERSION" \
           "./VERSION" \
           "/etc/actual-budget/pkg.version"; do
    [[ -n "$f" && -r "$f" ]] || continue
    if grep -q '^PKG_VERSION=' "$f" 2>/dev/null; then
      # shellcheck disable=SC1090
      . "$f"
      [[ -n "$PKG_VERSION" ]] && { echo "$PKG_VERSION"; return; }
    else
      read -r v <"$f" || true
      [[ -n "$v" ]] && { echo "$v"; return; }
    fi
  done
}

_pkg_version() {
  local v
  v=$(__tklab_read_version_file)
  [[ -n "$v" ]] && { echo "$v"; return; }
  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    v=$(git describe --tags --abbrev=0 2>/dev/null || git describe --tags --always 2>/dev/null)
    [[ -n "$v" ]] && { echo "$v"; return; }
  fi
  awk -F: '/^# *Packaged-In/{gsub(/[ \t]/,"",$2); print $2; exit}' "${BASH_SOURCE[0]}" 2>/dev/null || echo "unknown"
}

_script_version() {
  awk -F: '/^# *Script-Version/{gsub(/[ \t]/,"",$2); print $2; exit}' "${BASH_SOURCE[0]}" 2>/dev/null || echo "unknown"
}

# Cache once per run
PKG_VERSION="$(_pkg_version)"
SCRIPT_VERSION="$(_script_version)"

# ───────────────────────────────────────────────────────────────────────────────
# Pretty banner + basic help
# ───────────────────────────────────────────────────────────────────────────────
banner() {
  # Detect width and whether stdout is a TTY
  local cols tty=0 dash line
  cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
  [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
  [[ -t 1 ]] && tty=1

  # Default to ASCII unless explicitly opted into UTF-8
  dash='-'
  if [[ "${USE_UTF8_BANNER:-0}" == "1" ]]; then
    if (( tty == 1 )) && locale 2>/dev/null | grep -qi 'utf-8'; then
      dash='─'
    fi
  fi
  line="$(printf "%${cols}s" | tr ' ' "$dash")"

  # Optional color (respect NO_COLOR and only when on a TTY)
  local clr_reset="" clr_em=""
  if (( tty == 1 )) && [[ -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1; then
    clr_reset="$(tput sgr0 2>/dev/null || true)"
    clr_em="$(tput bold 2>/dev/null || true)"
  fi

  printf '%s\n' "$line"
  printf '  %stkl-actual-bootstrap%s : actualctl (%s) - package %s\n' \
    "$clr_em" "$clr_reset" "${SCRIPT_VERSION}" "${PKG_VERSION}"
  printf '  Ops CLI for Actual Sync Server on TurnKey Linux\n'
  printf '  License: GPL-3.0-or-later\n'
  printf '  Author: Ken Robinson <ken@turnkeylinux.org>\n'
  printf '  Source: https://github.com/DocCyblade/tkl-actual-bootstrap\n'
  printf '  Hint:   actualctl --help\n'
  printf '%s\n' "$line"
}

usage_quick() {
  cat <<'HELP'
Usage: actualctl <command> [args]
Hint : actualctl --help    # full documentation and examples
HELP
}

print_usage() {
  cat <<'HELP'
Usage: actualctl <command> [args]

Commands (high level):
  help | --help | -h          Show full help and exit
  version | --version         Show script/package version
  list                        Show instances, symlink targets, and service status
  check                       Run basic health checks (tools present, dirs exist)
  env [INSTANCE]              Show environment & paths (all or one)
  health [INSTANCE]           Check Nginx upstream + backend health (all if omitted)
  doctor [--fix]              Full system check (services, ports, nginx -t, upstream); --fix also installs package VERSION manifest

Version & app mgmt:
  fetch <vX.Y.Z>              Install @actual-app/sync-server@<ver> into /srv/app/<ver>
  switch <INSTANCE> <vX.Y.Z>  Point /srv/app/<INSTANCE> -> /srv/app/<ver>, restart service
  verify <vX.Y.Z>             Install to a temp dir and run a smoke check, then remove
  prune-versions [--dry-run] [--keep N] [--older-than DAYS]  Remove unused /srv/app/v* (not targeted by any instance link)

Backups:
  backup <INSTANCE> [note]    Tar user-data to /srv/backups/<instance>-<ts>[-note].tgz
  restore <INSTANCE> <tgz>    Stop service, backup current, restore tgz, chown, start
  prune-backups [--keep N]    Keep N most-recent per instance (default: 7)

Instances:
  instance add <NAME> <ver|development|test|production> [--from SRC] [--port PORT]
                              Create /srv/<NAME>/data (optionally copy from SRC),
                              create unit, link /srv/app/<NAME> -> target, start.
                              If --port omitted, picks next free port automatically.
  instance rm  <NAME> [--purge]
                              Stop/disable unit, remove unit, (optional) delete /srv/<NAME>
  instance set-port <NAME> <PORT>
                              Update /srv/<NAME>/data/config.json port and restart service

Service wrappers:
  service <INSTANCE> start|stop|restart|status
  logs    <INSTANCE> [lines]  Tail journal for the instance unit

Full Examples see docs/README.actualctl.txt

HELP
}

# If no args, show quick usage (consistent with project UX)
if [[ $# -eq 0 ]]; then banner; usage_quick; exit 0; fi
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then banner; print_usage; exit 0; fi
if [[ "${1:-}" == "--version" || "${1:-}" == "version" ]]; then echo "actualctl ${SCRIPT_VERSION} (package ${PKG_VERSION})"; exit 0; fi

# ───────────────────────────────────────────────────────────────────────────────
# Constants / defaults
# ───────────────────────────────────────────────────────────────────────────────
APP_USER="budget-server"
APP_GROUP="budget-server"

BASE_APP="/srv/app"       # versions + instance symlinks
BACKUPS="/srv/backups"    # backup archives

# Well-known instances
INSTANCES=(development test production)

# Default port map (may be overridden per-instance)
declare -A PORTS=( ["development"]=5006 ["test"]=5000 ["production"]=5001 )

# ───────────────────────────────────────────────────────────────────────────────
# Helpers
# ───────────────────────────────────────────────────────────────────────────────
log()  { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
err()  { printf '[ERR ] %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

require_root() {
  [[ $(id -u) -eq 0 ]] || die "Run as root (no sudo)."
}

# Execute a command as APP_USER, using runuser if present; fallback to su.
as_user() {
  if command -v runuser >/dev/null 2>&1; then
    runuser -u "$APP_USER" -- bash -lc "$*"
  else
    su -s /bin/bash - "$APP_USER" -c "$*"
  fi
}


# Read domain from /etc/actual-budget/env (written by bootstrap)
read_domain() {
  local f="/etc/actual-budget/env"
  [[ -f "$f" ]] || return 1
  local line; line="$(grep -E '^BUDGET_DOMAIN=' "$f" || true)"
  [[ -n "$line" ]] || return 1
  line="${line#BUDGET_DOMAIN=}"
  line="${line%\"}"; line="${line#\"}"
  printf '%s\n' "$line"
}

# Install / update the package VERSION manifest to the system path
install_version_manifest() {
  require_root
  local bundle_dir src dest_dir dst
  bundle_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  src="${bundle_dir}/VERSION"
  dest_dir="/usr/share/tkl-actual-bootstrap"
  dst="${dest_dir}/VERSION"

  if [[ -f "$src" ]]; then
    log "installing package VERSION manifest to $dst"
    install -d -m 0755 "$dest_dir"
    if command -v cmp >/dev/null 2>&1 && [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
      log "manifest up-to-date: $dst"
    else
      install -m 0644 "$src" "$dst"
      log "manifest installed: $dst"
    fi
  else
    warn "VERSION not found at $src; skipping"
  fi
}

# Prefer jq for JSON; fallback to awk (keeps zero-dep behavior on TurnKey).
json_get() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 1
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$key" '.[$k] // empty' "$file" 2>/dev/null
  else
    # naive but sufficient for our simple config.json (flat key/value)
    awk -v k="\""${key}"\"" -F ':' '
      $1 ~ k {
        v=$2
        gsub(/^[ \t"]+|[", \t\r\n]+$/, "", v)
        print v
        exit
      }' "$file" 2>/dev/null
  fi
}

# Discover instances: include well-known + any /srv/* that has data/.
# Keep output stable by sorting additions.
discover_instances() {
  local seen=" development test production "
  local out=(development test production)
  local d n add=()

  for d in /srv/*; do
    [[ -d "$d/data" ]] || continue
    n="$(basename "$d")"
    [[ "$seen" == *" $n "* ]] || add+=("$n")
  done

  if ((${#add[@]})); then
    IFS=$'\n' add=($(printf '%s\n' "${add[@]}" | sort))
    unset IFS
    out+=("${add[@]}")
  fi
  printf '%s\n' "${out[@]}"
}

# Pick the next available port, starting from 5002 upward, skipping any used
# by existing instance config.json files.
pick_next_port() {
  local used=() n p
  while IFS= read -r n; do
    p="$(json_get "/srv/$n/data/config.json" port || true)"
    [[ -n "$p" ]] && used+=("$p")
  done < <(discover_instances)

  for ((p=5002; p<65535; p++)); do
    local taken=0
    for x in "${used[@]}"; do
      [[ "$x" = "$p" ]] && { taken=1; break; }
    done
    (( taken == 0 )) && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

# ───────────────────────────────────────────────────────────────────────────────
# Commands
# ───────────────────────────────────────────────────────────────────────────────

cmd_list() {
  # Human table of instances + symlinked version + service status
  printf "%-12s %-28s %s\n" "INSTANCE" "LINK->VERSION" "SERVICE"
  while IFS= read -r inst; do
    local link="${BASE_APP}/${inst}" target="(none)"
    if [[ -L "$link" ]]; then
      target="$(basename "$(readlink -f "$link")")"
    fi
    local svc="${inst}-budgetapp.service" state
    state="$(systemctl is-active "$svc" 2>/dev/null || echo inactive)"
    printf "%-12s %-28s %s\n" "$inst" "${target#${BASE_APP}/}" "$state"
  done < <(discover_instances)

  echo
  echo "Available versions under ${BASE_APP}:"
  local vs=()
  shopt -s nullglob
  for d in "${BASE_APP}"/v*; do [[ -d "$d" ]] && vs+=("$(basename "$d")"); done
  shopt -u nullglob
  if ((${#vs[@]})); then
    printf "%s\n" "${vs[@]}" | sort -V
  else
    echo "(none)"
  fi
}

cmd_check() {
  require_root
  local ok=1

  # Basic toolchain presence
  for c in node npm systemctl nginx; do
    command -v "$c" >/dev/null 2>&1 || { err "Missing: $c"; ok=0; }
  done

  # Data dirs exist for discovered instances
  while IFS= read -r inst; do
    local dat="/srv/${inst}/data"
    [[ -d "$dat" ]] || { err "Missing data dir: $dat"; ok=0; }
    local svc="${inst}-budgetapp.service"
    systemctl status "$svc" >/dev/null 2>&1 || warn "Service not active: $svc"
  done < <(discover_instances)

  [[ $ok -eq 1 ]] && log "check: OK" || die "check: FAIL"
}

cmd_env() {
  # Show per-instance env summary
  local inst="${1:-}"
  if [[ -z "$inst" ]]; then
    while IFS= read -r i; do cmd_env "$i"; echo; done < <(discover_instances)
    return 0
  fi

  local dat="/srv/${inst}/data"
  local cfg="${dat}/config.json"
  local link="${BASE_APP}/${inst}"
  local ver="(none)"
  [[ -L "$link" ]] && ver="$(basename "$(readlink -f "$link")")"
  local port host; port="$(json_get "$cfg" port)"; host="$(json_get "$cfg" hostname)"

  printf "%s:\n  ACTUAL_DATA_DIR=%s\n  config=%s (port=%s host=%s)\n  app_link=%s -> %s\n" \
    "$inst" "$dat" "$cfg" "${port:-?}" "${host:-?}" "$link" "$ver"
}

cmd_fetch() {
  # Install a specific version under /srv/app/<ver> (local npm)
  require_root
  local ver="${1:-}"; [[ -n "$ver" ]] || die "Usage: actualctl fetch <vX.Y.Z>"
  local dest="${BASE_APP}/${ver}"

  log "fetch: installing ${ver} into ${dest}"
  mkdir -p "$dest"
  chown -R "$APP_USER:$APP_GROUP" "$dest"

  if [[ -f "${dest}/node_modules/@actual-app/sync-server/package.json" ]]; then
    log "already present: ${ver}"
    return 0
  fi

  as_user "cd \"$dest\" \
    && { test -f package.json || npm init -y; } \
    && npm config set fund false \
    && npm config set audit false \
    && npm install \"@actual-app/sync-server@${ver}\""

  log "fetch: done"
}

cmd_switch() {
  # Point instance symlink to a given version and restart
  require_root
  local inst="${1:-}" ver="${2:-}"
  [[ -n "$inst" && -n "$ver" ]] || die "Usage: actualctl switch <INSTANCE> <vX.Y.Z>"

  local link="${BASE_APP}/${inst}" target="${BASE_APP}/${ver}"
  [[ -d "$target" ]] || die "Version not installed: $ver"

  ln -sfn "$target" "$link"
  systemctl restart "${inst}-budgetapp.service"
  log "switch: $inst -> $ver"
}

cmd_verify() {
  # Dry-run install to temp dir (does not affect running instances)
  require_root
  local ver="${1:-}"; [[ -n "$ver" ]] || die "Usage: actualctl verify <vX.Y.Z>"
  local npmver="${ver#v}"

  local tmp="${BASE_APP}/.verify-${ver}.$(date +%s)"
  mkdir -p "$tmp"
  chown -R "$APP_USER:$APP_GROUP" "$tmp"

  # Always clean up temp on exit/failure (nicer for nounset)
  trap "rm -rf '$tmp' 2>/dev/null || true" EXIT

  log "verify: installing to temp $tmp"
  as_user "cd \"$tmp\" \
    && npm init -y >/dev/null 2>&1 \
    && npm config set fund false \
    && npm config set audit false \
    && npm install \"@actual-app/sync-server@${npmver}\""

  [[ -d "$tmp/node_modules/@actual-app/sync-server" ]] \
    && log "verify: OK (module present)" \
    || die "verify: install failed"
}

cmd_backup() {
  # Create a tarball of instance user-data into /srv/backups
  require_root
  local inst="${1:-}" note="${2:-}"
  [[ -n "$inst" ]] || die "Usage: actualctl backup <INSTANCE> [note]"

  local dat="/srv/${inst}/data"; [[ -d "$dat" ]] || die "Missing: $dat"
  mkdir -p "$BACKUPS"

  local ts base out
  ts="$(date +%Y%m%d-%H%M%S)"
  base="${inst}-${ts}"
  [[ -n "$note" ]] && base="${base}-${note//[^A-Za-z0-9._-]/_}"
  out="${BACKUPS}/${base}.tgz"

  tar -C "$dat" -czf "$out" .
  log "backup: $out"
  echo "$out"
}

cmd_restore() {
  # Restore a prior backup (auto backup current first)
  require_root
  local inst="${1:-}" tgz="${2:-}"
  [[ -n "$inst" && -n "$tgz" ]] || die "Usage: actualctl restore <INSTANCE> <archive.tgz>"

  local dat="/srv/${inst}/data"; [[ -d "$dat" ]] || die "Missing: $dat"
  systemctl stop "${inst}-budgetapp.service" || true
  cmd_backup "$inst" pre-restore >/dev/null || true

  rm -rf "${dat}/"* 2>/dev/null || true
  tar -C "$dat" -xzf "$tgz"
  chown -R "$APP_USER:$APP_GROUP" "/srv/${inst}"

  systemctl start "${inst}-budgetapp.service"
  log "restore: done for $inst"
}

cmd_prune_backups() {
  # Keep N newest backups per instance (default 7)
  require_root
  local keep=7
  if [[ "${1:-}" == "--keep" ]]; then keep="${2:-7}"; fi
  mkdir -p "$BACKUPS"

  local inst
  for inst in $(discover_instances); do
    mapfile -t files < <(ls -1t "$BACKUPS"/${inst}-*.tgz 2>/dev/null || true)
    if (( ${#files[@]} > keep )); then
      for f in "${files[@]:$keep}"; do
        rm -f "$f"
        log "pruned: $f"
      done
    fi
  done
  log "prune-backups: keep=${keep}"
}

cmd_prune_versions() {
  # Remove unused /srv/app/v* versions, with optional keep/age filters
  require_root
  local dry=0 keep=0 older=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=1; shift;;
      --keep)    keep="${2:-0}"; shift 2;;
      --older-than) older="${2:-0}"; shift 2;;
      *) err "Unknown option: $1"; return 2;;
    esac
  done

  # Discover installed versions
  shopt -s nullglob
  local installed=() d base
  for d in "${BASE_APP}"/v*; do
    [[ -d "$d" ]] || continue
    base="$(basename "$d")"
    [[ "$base" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    installed+=("$base")
  done
  shopt -u nullglob

  # Discover versions in use (targets of instance links)
  local used=() inst link tgt ver
  while IFS= read -r inst; do
    link="${BASE_APP}/${inst}"
    if [[ -L "$link" ]]; then
      tgt="$(readlink -f "$link")"
      ver="$(basename "$tgt")"
      used+=("$ver")
    fi
  done < <(discover_instances)

  # Compute unused = installed - used
  local ulist=" ${used[*]} " unused=() v
  for v in "${installed[@]}"; do
    [[ " $ulist " == *" $v "* ]] || unused+=("$v")
  done

  if ((${#unused[@]} == 0)); then
    log "prune-versions: nothing to prune (no unused versions)"
    return 0
  fi

  # Start with unused as candidates
  local candidates=("${unused[@]}")

  # Apply --keep N: keep N most-recent by version (descending)
  if (( keep > 0 )); then
    local sorted=() keepers=() tmp=()
    mapfile -t sorted < <(printf "%s\n" "${candidates[@]}" | sort -Vr)
    keepers=("${sorted[@]:0:keep}")
    local kset=" ${keepers[*]} "
    for v in "${candidates[@]}"; do
      [[ " $kset " == *" $v "* ]] || tmp+=("$v")
    done
    candidates=("${tmp[@]}")
  fi

  # Apply --older-than DAYS: only prune versions older than threshold (by dir mtime)
  if (( older > 0 )); then
    local now age filt=()
    now="$(date +%s)"
    for v in "${candidates[@]}"; do
      local path="${BASE_APP}/${v}" mtime=0
      # GNU stat (%Y) fallback to BSD stat (-f %m)
      mtime="$(stat -c %Y "$path" 2>/dev/null || stat -f %m "$path" 2>/dev/null || echo 0)"
      if [[ "$mtime" =~ ^[0-9]+$ ]] && (( mtime > 0 )); then
        age=$(( (now - mtime) / 86400 ))
        (( age >= older )) && filt+=("$v")
      else
        # If we can't read mtime, be conservative: include it for pruning
        filt+=("$v")
      fi
    done
    candidates=("${filt[@]}")
  fi

  if ((${#candidates[@]} == 0)); then
    log "prune-versions: nothing matches filters (keep=${keep}, older-than=${older})"
    return 0
  fi

  printf "prune-versions: installed=%d used=%d unused=%d prune=%d\n" \
    "${#installed[@]}" "${#used[@]}" "${#unused[@]}" "${#candidates[@]}"

  for v in "${candidates[@]}"; do
    local path="${BASE_APP}/${v}"
    if (( dry )); then
      echo "[dry-run] rm -rf '$path'"
    else
      rm -rf "$path"
      log "removed: $path"
    fi
  done
}

# Render a systemd unit for a given instance (used by instance add)
_unit_text() {
  local inst="$1"
  local linkdir="${BASE_APP}/${inst}"
  local datadir="/srv/${inst}/data"
  cat <<UNIT
[Unit]
Description=Actual Sync Server (${inst})
After=network.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_GROUP}
WorkingDirectory=${linkdir}
Environment=NODE_ENV=production
Environment=ACTUAL_DATA_DIR=${datadir}
ExecStart=/usr/bin/env bash -lc './node_modules/.bin/actual-server'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT
}

cmd_instance_add() {
  # Create a new instance, optionally copying data and/or choosing a port
  require_root

  local name="${1:-}" target="${2:-}" fromInst="" want_port=""
  [[ -n "$name" && -n "$target" ]] \
    || die "Usage: actualctl instance add <NAME> <vX.Y.Z|development|test|production> [--from SRC] [--port PORT]"
  shift 2

  # Parse optional flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) fromInst="${2:-}"; shift 2;;
      --port) want_port="${2:-}"; shift 2;;
      *) err "Unknown option: $1"; return 2;;
    esac
  done

  # Create data dir and optionally copy from an existing instance
  local dat="/srv/${name}/data"
  mkdir -p "$dat"
  if [[ -n "$fromInst" ]]; then
    local src="/srv/${fromInst}/data"
    [[ -d "$src" ]] || die "Source data missing: $src"
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --delete "$src/." "$dat/"
    else
      warn "rsync not found; falling back to cp -a (no deletion of extraneous files)"
      cp -a "$src/." "$dat/"
    fi
  fi
  chown -R "$APP_USER:$APP_GROUP" "/srv/${name}"

  # Link to target version or to another instance's resolved version
  local link="${BASE_APP}/${name}" tgt="${BASE_APP}/${target}"
  if [[ ! -d "$tgt" ]]; then
    if [[ -L "${BASE_APP}/${target}" ]]; then
      tgt="$(readlink -f "${BASE_APP}/${target}")"
    else
      die "Target version/instance not installed: $target"
    fi
  fi
  ln -sfn "$tgt" "$link"

  # Write config.json with selected or next-free port
  local cfg="${dat}/config.json" host="127.0.0.1" port=""
  if [[ -n "$want_port" ]]; then
    port="$want_port"
  else
    port="$(pick_next_port || true)"
    [[ -n "$port" ]] || die "Unable to find an available port"
  fi
  {
    echo "{"
    echo "  \"port\": ${port},"
    echo "  \"hostname\": \"${host}\""
    echo "}"
  } > "$cfg"
  chown -R "$APP_USER:$APP_GROUP" "/srv/${name}"

  # Install and start systemd unit
  local unit="/etc/systemd/system/${name}-budgetapp.service"
  _unit_text "$name" > "$unit"
  systemctl daemon-reload
  systemctl enable --now "${name}-budgetapp.service"

  log "instance add: $name -> $(basename "$tgt")"
  log "instance add: ${name} port=${port}"
}

cmd_instance_rm() {
  # Remove an instance (and optionally purge its /srv/<name>)
  require_root
  local name="${1:-}" purge=0
  [[ -n "$name" ]] || die "Usage: actualctl instance rm <NAME> [--purge]"
  [[ "${2:-}" == "--purge" ]] && purge=1

  systemctl disable --now "${name}-budgetapp.service" || true
  rm -f "/etc/systemd/system/${name}-budgetapp.service"
  systemctl daemon-reload

  rm -f "${BASE_APP}/${name}"
  if (( purge )); then
    rm -rf "/srv/${name}"
    log "purged /srv/${name}"
  fi
  log "instance rm: $name"
}

cmd_instance_set_port() {
  # Update an instance port in config.json and restart the service
  require_root
  local name="${1:-}" newp="${2:-}"
  [[ -n "$name" && -n "$newp" ]] || die "Usage: actualctl instance set-port <NAME> <PORT>"
  [[ "$newp" =~ ^[0-9]+$ ]] || die "PORT must be numeric"

  local dat="/srv/${name}/data" cfg="${dat}/config.json"
  [[ -d "$dat" ]] || die "Instance data dir not found: $dat"
  local host; host="$(json_get "$cfg" hostname)"; [[ -n "$host" ]] || host="127.0.0.1"

  local tmp; tmp="$(mktemp)"
  {
    echo "{"
    echo "  \"port\": ${newp},"
    echo "  \"hostname\": \"${host}\""
    echo "}"
  } > "$tmp"

  install -m 0644 "$tmp" "$cfg"
  rm -f "$tmp"

  chown -R "$APP_USER:$APP_GROUP" "/srv/${name}"
  systemctl restart "${name}-budgetapp.service"
  log "instance set-port: ${name} -> ${newp}"
}

cmd_service() {
  # Thin wrapper around systemctl for instance units
  require_root
  local inst="${1:-}" op="${2:-}"
  [[ -n "$inst" && -n "$op" ]] || die "Usage: actualctl service <INSTANCE> start|stop|restart|status"
  systemctl "$op" "${inst}-budgetapp.service"
}

cmd_logs() {
  # Journal tail convenience
  local inst="${1:-}" lines="${2:-200}"
  [[ -n "$inst" ]] || die "Usage: actualctl logs <INSTANCE> [lines]"
  journalctl -u "${inst}-budgetapp.service" -n "$lines" --no-pager
}

# Internal: curl and return HTTP code (or empty)
_curl_code() {
  curl -fsS -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 5 --insecure "$1" || true
}

cmd_health() {
  # Upstream (Nginx) + backend (localhost:port) health
  local inst="${1:-}" domain; domain="$(read_domain || true)"
  local rc=0

  if [[ -z "$inst" ]]; then
    while IFS= read -r i; do cmd_health "$i" || rc=1; done < <(discover_instances)
    [[ $rc -eq 0 ]] || return 1
    return 0
  fi

  local cfg="/srv/${inst}/data/config.json" port
  port="$(json_get "$cfg" port)"
  [[ -n "$port" ]] || { err "health: no port in $cfg"; return 1; }

  if [[ -n "$domain" ]]; then
    local host up code
    host="${inst}-budgetapp.${domain}"
    up="https://${host}/health/upstream"
    code="$(_curl_code "$up")"
    if [[ "$code" == "200" ]]; then
      log "health: upstream OK (${inst}) 200 ${up}"
    else
      err "health: upstream FAIL (${inst}) code=${code:-NA} ${up}"
      rc=1
    fi
  else
    warn "health: domain not set in /etc/actual-budget/env; skipping upstream check for ${inst}"
  fi

  local be="http://127.0.0.1:${port}/" bcode
  bcode="$(_curl_code "$be")"
  if [[ "$bcode" == "200" || "$bcode" == "404" ]]; then
    log "health: backend OK (${inst}) code=${bcode} ${be}"
  else
    err "health: backend FAIL (${inst}) code=${bcode:-NA} ${be}"
    rc=1
  fi

  [[ $rc -eq 0 ]]
}

cmd_doctor() {
  # Comprehensive: tools, nginx -t, services active, ports, upstream
  require_root
  local ok=1 fix=0
  [[ "${1:-}" == "--fix" ]] && fix=1

  # Toolchain
  for c in node npm systemctl nginx curl ss; do
    command -v "$c" >/dev/null 2>&1 || { err "doctor: missing tool: $c"; ok=0; }
  done

  # Nginx sanity
  if nginx -t >/dev/null 2>&1; then
    log "doctor: nginx -t OK"
  else
    err "doctor: nginx -t FAILED"
    ok=0
  fi

  # Services + ports
  while IFS= read -r inst; do
    local svc="${inst}-budgetapp.service"
    if systemctl is-active --quiet "$svc"; then
      log "doctor: service OK ${svc}"
    else
      err "doctor: service NOT ACTIVE ${svc}"
      ok=0
    fi

    local cfg="/srv/${inst}/data/config.json" port
    port="$(json_get "$cfg" port)"
    if [[ -z "$port" ]]; then
      err "doctor: ${inst} missing port in ${cfg}"
      ok=0
    else
      if ss -ltn | awk '{print $4}' | grep -q ":${port}$"; then
        log "doctor: port listen OK ${inst}:${port}"
      else
        err "doctor: port NOT LISTENING ${inst}:${port}"
        ok=0
      fi
    fi
  done < <(discover_instances)

  # Upstream via Nginx
  if cmd_health >/dev/null; then
    log "doctor: upstream health OK"
  else
    err "doctor: upstream health FAILED"
    ok=0
  fi

  # Optional remediation
  if (( fix )); then
    install_version_manifest || ok=0
  fi

  [[ $ok -eq 1 ]] && log "doctor: OK" || { err "doctor: FAIL"; return 1; }
}

# ───────────────────────────────────────────────────────────────────────────────
# Dispatcher
# ───────────────────────────────────────────────────────────────────────────────
case "${1:-}" in
  list)           shift; cmd_list "$@";;
  check)          shift; cmd_check "$@";;
  env)            shift; cmd_env "$@";;
  health)         shift; cmd_health "$@";;
  doctor)         shift; cmd_doctor "$@";;

  fetch)          shift; cmd_fetch "$@";;
  switch)         shift; cmd_switch "$@";;
  verify)         shift; cmd_verify "$@";;

  backup)         shift; cmd_backup "$@";;
  restore)        shift; cmd_restore "$@";;
  prune-backups)  shift; cmd_prune_backups "$@";;
  prune-versions)  shift; cmd_prune_versions "$@";;

  instance)
    shift
    case "${1:-}" in
      add)       shift; cmd_instance_add "$@";;
      rm)        shift; cmd_instance_rm "$@";;
      set-port)  shift; cmd_instance_set_port "$@";;
      *) err "Unknown: instance ${1:-}"; usage_quick; exit 2;;
    esac
    ;;

  service)        shift; cmd_service "$@";;
  logs)           shift; cmd_logs "$@";;

  help|-h|--help) print_usage ;;
  version|--version) echo "actualctl ${SCRIPT_VERSION} (package ${PKG_VERSION})" ;;

  *) err "Unknown command: ${1:-}"; usage_quick; exit 2;;
esac