#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# tkl-actual-bootstrap : scripts/actualctl
# Version: v0.23.1
#
# Purpose
# -------
# Orchestrates multi-instance Actual Sync Server on TurnKey Linux:
# - Manage installed app versions under /srv/app/vX.Y.Z
# - Switch instance symlinks: /srv/app/{development,test,production} -> /srv/app/vX.Y.Z
# - Create/manage additional instances
# - Back up & restore instance data under /srv/<instance>/data
# - Health checks (backend and via Nginx) and a consolidated "doctor"
#
# Project:  tkl-actual-bootstrap  (Bootstrap for Actual Sync Server on TurnKey Linux)
# License:  GPL-3.0-or-later
# Author:   Ken Robinson <ken@turnkeylinux.org>
# Source:   https://github.com/DocCyblade/tkl-actual-bootstrap
#
# Recent changes (see CHANGELOG.md for full history)
# - v0.23.1: Fix `list` to only show version directories (v*), never print contents.
# - v0.23.0: Add `instance set-port`, `health`, and `doctor`; help/README parity.
# - v0.22.x: Quality-of-life improvements, stable ExecStart in units.
#
set -Eeuo pipefail

# ────────────────────────────────────────────────────────────────────────────────
# Banner & Help
# ────────────────────────────────────────────────────────────────────────────────
banner() {
  cat <<'BANNER'
┌──────────────────────────────────────────────────────────────────────────────┐
│ tkl-actual-bootstrap : actualctl                                 v0.23.1     │
│ Bootstrap for running Actual Sync Server on TurnKey Linux                     │
│ License: GPL-3.0-or-later                                                     │
│ Author: Ken Robinson <ken@turnkeylinux.org>                                   │
│ Source: https://github.com/DocCyblade/tkl-actual-bootstrap                    │
│ Hint:   actualctl --help                                                      │
└──────────────────────────────────────────────────────────────────────────────┘
BANNER
}

# A short usage shown when no args or unknown command are provided.
usage_quick() {
  cat <<'HELP'
Usage: actualctl <command> [args]
Hint : actualctl --help    # for full documentation and examples
HELP
}

# The full help, including command list and examples.
print_usage() {
  cat <<'HELP'
Usage: actualctl <command> [args]

Commands (high level):
  help                          Show this help and exit
  list                          Show instances, symlink targets, and versions
  check                         Run basic health checks
  env [INSTANCE]                Show environment & paths (all or one)
  health [INSTANCE]             Check Nginx upstream + backend health (all if omitted)
  doctor                        Full system check (services, ports, nginx -t, upstream)

Version & app mgmt:
  fetch <vX.Y.Z>                Install @actual-app/sync-server@<ver> into /srv/app/<ver>
  switch <INSTANCE> <vX.Y.Z>    Point /srv/app/<INSTANCE> -> /srv/app/<ver>, restart service
  verify <vX.Y.Z>               Install to a temp dir and run a smoke check, then remove

Backups:
  backup <INSTANCE> [note]      Tar user-data to /srv/backups/<instance>-<ts>[-note].tgz
  restore <INSTANCE> <tgz>      Stop service, backup current, restore tgz, chown, start
  prune-backups [--keep N]      Keep N most-recent per instance (default: 7)

Instances:
  instance add <NAME> <ver|development|test|production> [--from SRC] [--port PORT]
                                Create /srv/<NAME>/data (optionally copy from SRC),
                                create unit, link /srv/app/<NAME> -> target, start.
                                If --port omitted, picks next free port automatically.
  instance rm  <NAME> [--purge] Stop/disable unit, remove unit, (optional) delete /srv/<NAME>
  instance set-port <NAME> <PORT>
                                Update /srv/<NAME>/data/config.json port and restart service

Service wrappers:
  service <INSTANCE> start|stop|restart|status
  logs    <INSTANCE> [lines]    Tail journal for the instance unit

Examples:
  actualctl list
  actualctl fetch v25.7.1
  actualctl switch production v25.7.1
  actualctl backup production "pre-upgrade"
  actualctl restore production /srv/backups/production-20250101-120000-pre-upgrade.tgz
  actualctl instance add staging v25.7.1 --from production --port 5002
  actualctl instance set-port staging 5003
  actualctl health production
  actualctl doctor
  actualctl prune-backups --keep 10
HELP
}

# Behavior: with no args show banner + quick usage; with --help show full help.
if [[ $# -eq 0 ]]; then
  banner; usage_quick; exit 0
fi
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
  banner; print_usage; exit 0
fi

# ────────────────────────────────────────────────────────────────────────────────
# Global configuration and tiny helpers
# ────────────────────────────────────────────────────────────────────────────────
APP_USER="budget-server"
APP_GROUP="budget-server"
BASE_APP="/srv/app"
BACKUPS="/srv/backups"

# Base instances always recognized; discover_instances() will also add any /srv/*/data
INSTANCES=(development test production)
declare -A PORTS=( ["development"]=5006 ["test"]=5000 ["production"]=5001 )

log()  { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
err()  { printf '[ERR ] %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# Execute a command as APP_USER (prefers runuser, falls back to su)
as_user() {
  if command -v runuser >/dev/null 2>&1; then
    runuser -u "$APP_USER" -- bash -lc "$*"
  else
    su -s /bin/bash - "$APP_USER" -c "$*"
  fi
}

# Enforce root context for mutating commands (no sudo assumptions)
require_root() { [[ $(id -u) -eq 0 ]] || die "Run as root (no sudo)."; }

# Minimal JSON extractor (schema is tiny: port, hostname). Prefer jq if available.
# json_get <file> <key>
json_get() {
  awk -v k="$2" -F': *' '/"'"$2"'"/ {gsub(/[",]/,"",$2); print $2; exit}' "$1" 2>/dev/null || true
}

# Discover instances dynamically by presence of /srv/*/data
discover_instances() {
  local seen=" development test production "
  local out=(development test production)
  local d n
  for d in /srv/*; do
    [[ -d "$d/data" ]] || continue
    n="$(basename "$d")"
    [[ "$seen" == *" $n "* ]] || { out+=("$n"); seen+=" $n "; }
  done
  printf '%s\n' "${out[@]}"
}

# Read BUDGET_DOMAIN from the env file written by bootstrap (if present)
read_domain() {
  local f="/etc/actual-budget/env"
  [[ -f "$f" ]] || return 1
  local line
  line="$(grep -E '^BUDGET_DOMAIN=' "$f" || true)"
  [[ -n "$line" ]] || return 1
  line="${line#BUDGET_DOMAIN=}"
  line="${line%\"}"; line="${line#\"}"
  printf '%s\n' "$line"
}

# Determine the next free port >= 5002 based on all instance config.json files
pick_next_port() {
  local used=()
  local p
  while IFS= read -r n; do
    p="$(json_get "/srv/$n/data/config.json" port || true)"
    [[ -n "$p" ]] && used+=("$p")
  done < <(discover_instances)

  for ((p=5002; p<65535; p++)); do
    local found=0
    for x in "${used[@]}"; do
      [[ "$x" = "$p" ]] && { found=1; break; }
    done
    [[ $found -eq 0 ]] && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

# ────────────────────────────────────────────────────────────────────────────────
# Commands
# ────────────────────────────────────────────────────────────────────────────────

# List instances and installed versions.
cmd_list() {
  printf "%-12s %-28s %s\n" "INSTANCE" "LINK->VERSION" "SERVICE"
  while IFS= read -r inst; do
    local link="${BASE_APP}/${inst}"
    local target="(none)"
    if [[ -L "$link" ]]; then
      target="$(basename "$(readlink -f "$link")")"
    fi
    local svc="${inst}-budgetapp.service"
    local state
    state="$(systemctl is-active "$svc" 2>/dev/null || echo inactive)"
    printf "%-12s %-28s %s\n" "$inst" "${target#${BASE_APP}/}" "$state"
  done < <(discover_instances)

  echo
  echo "Available versions under ${BASE_APP}:"
  # Only show version directories (v*). Do not expand or list contents.
  local vs=()
  shopt -s nullglob
  for d in "${BASE_APP}"/v*; do
    [[ -d "$d" ]] && vs+=("$(basename "$d")")
  done
  shopt -u nullglob
  if ((${#vs[@]})); then
    printf "%s\n" "${vs[@]}" | sort -V
  else
    echo "(none)"
  fi
}

# Basic sanity checks (tools, data dirs, services exist)
cmd_check() {
  require_root
  local ok=1
  for c in node npm systemctl nginx; do
    if ! command -v "$c" >/dev/null 2>&1; then err "Missing: $c"; ok=0; fi
  done
  while IFS= read -r inst; do
    local dat="/srv/${inst}/data"
    [[ -d "$dat" ]] || { err "Missing data dir: $dat"; ok=0; }
    local svc="${inst}-budgetapp.service"
    systemctl status "$svc" >/dev/null 2>&1 || warn "Service not active: $svc"
  done < <(discover_instances)
  [[ $ok -eq 1 ]] && log "check: OK" || die "check: FAIL"
}

# Print environment paths and selected port/host per instance
cmd_env() {
  local inst="${1:-}"
  if [[ -z "$inst" ]]; then
    while IFS= read -r i; do
      cmd_env "$i"; echo
    done < <(discover_instances)
    return 0
  fi
  local dat="/srv/${inst}/data"
  local cfg="${dat}/config.json"
  local link="${BASE_APP}/${inst}"
  local ver="(none)"
  if [[ -L "$link" ]]; then
    ver="$(basename "$(readlink -f "$link")")"
  fi
  local port host
  port="$(json_get "$cfg" port)"
  host="$(json_get "$cfg" hostname)"
  printf "%s:\n  ACTUAL_DATA_DIR=%s\n  config=%s (port=%s host=%s)\n  app_link=%s -> %s\n" \
    "$inst" "$dat" "$cfg" "${port:-?}" "${host:-?}" "$link" "$ver"
}

# Fetch/install an Actual version into /srv/app/<ver> using npm as budget-server
cmd_fetch() {
  require_root
  local ver="${1:-}"
  [[ -n "$ver" ]] || die "Usage: actualctl fetch <vX.Y.Z>"
  local dest="${BASE_APP}/${ver}"
  log "fetch: installing ${ver} into ${dest}"
  mkdir -p "$dest"; chown -R "$APP_USER:$APP_GROUP" "$dest"
  if [[ -f "${dest}/node_modules/@actual-app/sync-server/package.json" ]]; then
    log "already present: ${ver}"
    return 0
  fi
  as_user "cd \"$dest\" && { test -f package.json || npm init -y; } && npm config set fund false && npm config set audit false && npm install \"@actual-app/sync-server@${ver}\""
  log "fetch: done"
}

# Switch an instance symlink and restart its unit
cmd_switch() {
  require_root
  local inst="${1:-}"
  local ver="${2:-}"
  [[ -n "$inst" && -n "$ver" ]] || die "Usage: actualctl switch <INSTANCE> <vX.Y.Z>"
  local link="${BASE_APP}/${inst}"
  local target="${BASE_APP}/${ver}"
  [[ -d "$target" ]] || die "Version not installed: $ver"
  ln -sfn "$target" "$link"
  systemctl restart "${inst}-budgetapp.service"
  log "switch: $inst -> $ver"
}

# Verify a version by installing to a temp dir, then remove it
cmd_verify() {
  require_root
  local ver="${1:-}"
  [[ -n "$ver" ]] || die "Usage: actualctl verify <vX.Y.Z>"
  local tmp="${BASE_APP}/.verify-${ver}.$(date +%s)"
  mkdir -p "$tmp"; chown -R "$APP_USER:$APP_GROUP" "$tmp"
  log "verify: installing to temp $tmp"
  as_user "cd \"$tmp\" && npm init -y >/dev/null 2>&1 && npm config set fund false && npm config set audit false && npm install \"@actual-app/sync-server@${ver}\""
  if [[ -d "$tmp/node_modules/@actual-app/sync-server" ]]; then
    log "verify: OK (module present)"
  else
    rm -rf "$tmp"
    die "verify: install failed"
  fi
  rm -rf "$tmp"
  log "verify: cleaned"
}

# Create a timestamped tarball of an instance's data dir
cmd_backup() {
  require_root
  local inst="${1:-}"
  local note="${2:-}"
  [[ -n "$inst" ]] || die "Usage: actualctl backup <INSTANCE> [note]"
  local dat="/srv/${inst}/data"
  [[ -d "$dat" ]] || die "Missing: $dat"
  mkdir -p "$BACKUPS"
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  local base="${inst}-${ts}"
  if [[ -n "$note" ]]; then
    base="${base}-${note//[^A-Za-z0-9._-]/_}"
  fi
  local out="${BACKUPS}/${base}.tgz"
  tar -C "$dat" -czf "$out" .
  log "backup: $out"
  echo "$out"
}

# Restore a backup tarball to an instance (with pre-restore backup)
cmd_restore() {
  require_root
  local inst="${1:-}"
  local tgz="${2:-}"
  [[ -n "$inst" && -n "$tgz" ]] || die "Usage: actualctl restore <INSTANCE> <archive.tgz>"
  local dat="/srv/${inst}/data"
  [[ -d "$dat" ]] || die "Missing: $dat"
  systemctl stop "${inst}-budgetapp.service" || true
  cmd_backup "$inst" pre-restore >/dev/null || true
  rm -rf "${dat}/"* 2>/dev/null || true
  tar -C "$dat" -xzf "$tgz"
  chown -R "$APP_USER:$APP_GROUP" "/srv/${inst}"
  systemctl start "${inst}-budgetapp.service"
  log "restore: done for $inst"
}

# Keep only N newest backups per instance (default 7)
cmd_prune_backups() {
  require_root
  local keep=7
  if [[ "${1:-}" == "--keep" ]]; then
    keep="${2:-7}"
  fi
  mkdir -p "$BACKUPS"
  # ensure default instances are declared (shellcheck friendliness)
  for inst in "${INSTANCES[@]}"; do :; done
  # walk discovered instances
  for inst in $(discover_instances); do
    mapfile -t files < <(ls -1t "$BACKUPS"/${inst}-*.tgz 2>/dev/null || true)
    if (( ${#files[@]} > keep )); then
      for f in "${files[@]:$keep}"; do
        rm -f "$f"
        log "pruned: $f"
      done
    fi
  done
  log "prune-backups: keep=${keep}"
}

# Generate a systemd unit text for an instance
_unit_text() {
  local inst="$1"
  local linkdir="${BASE_APP}/${inst}"
  local datadir="/srv/${inst}/data"
  cat <<UNIT
[Unit]
Description=Actual Sync Server (${inst})
After=network.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_GROUP}
WorkingDirectory=${linkdir}
Environment=NODE_ENV=production
Environment=ACTUAL_DATA_DIR=${datadir}
ExecStart=/usr/bin/env bash -lc './node_modules/.bin/actual-server'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT
}

# Create a new instance (optional: seed data from another)
cmd_instance_add() {
  require_root
  local name="${1:-}"
  local target="${2:-}"
  local fromInst="" want_port=""
  [[ -n "$name" && -n "$target" ]] || die "Usage: actualctl instance add <NAME> <vX.Y.Z|development|test|production> [--from SRC] [--port PORT]"
  shift 2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) fromInst="${2:-}"; shift 2;;
      --port) want_port="${2:-}"; shift 2;;
      *) err "Unknown option: $1"; return 2;;
    esac
  done

  local dat="/srv/${name}/data"
  mkdir -p "$dat"
  if [[ -n "$fromInst" ]]; then
    local src="/srv/${fromInst}/data"
    [[ -d "$src" ]] || die "Source data missing: $src"
    rsync -a --delete "$src/." "$dat/"
  fi
  chown -R "$APP_USER:$APP_GROUP" "/srv/${name}"

  local link="${BASE_APP}/${name}"
  local tgt="${BASE_APP}/${target}"
  if [[ ! -d "$tgt" ]]; then
    if [[ -L "${BASE_APP}/${target}" ]]; then
      tgt="$(readlink -f "${BASE_APP}/${target}")"
    else
      die "Target version/instance not installed: $target"
    fi
  fi
  ln -sfn "$tgt" "$link"

  # seed minimal config.json
  local cfg="${dat}/config.json"
  local host="127.0.0.1"
  local port=""
  if [[ -n "$want_port" ]]; then
    port="$want_port"
  else
    port="$(pick_next_port || true)"
    [[ -n "$port" ]] || die "Unable to find an available port"
  fi
  {
    echo "{"
    echo "  \"port\": ${port},"
    echo "  \"hostname\": \"${host}\""
    echo "}"
  } > "$cfg"
  chown -R "$APP_USER:$APP_GROUP" "/srv/${name}"

  local unit="/etc/systemd/system/${name}-budgetapp.service"
  _unit_text "$name" > "$unit"
  systemctl daemon-reload
  systemctl enable --now "${name}-budgetapp.service"

  log "instance add: $name -> $(basename "$tgt")"
  log "instance add: ${name} port=${port}"
}

# Remove an instance (optionally purge its /srv/<name> dir)
cmd_instance_rm() {
  require_root
  local name="${1:-}"
  local purge=0
  [[ -n "$name" ]] || die "Usage: actualctl instance rm <NAME> [--purge]"
  if [[ "${2:-}" == "--purge" ]]; then
    purge=1
  fi
  systemctl disable --now "${name}-budgetapp.service" || true
  rm -f "/etc/systemd/system/${name}-budgetapp.service"
  systemctl daemon-reload
  rm -f "${BASE_APP}/${name}"
  if (( purge )); then
    rm -rf "/srv/${name}"
    log "purged /srv/${name}"
  fi
  log "instance rm: $name"
}

# Update the port in config.json and restart the instance unit
cmd_instance_set_port() {
  require_root
  local name="${1:-}" newp="${2:-}"
  [[ -n "$name" && -n "$newp" ]] || die "Usage: actualctl instance set-port <NAME> <PORT>"
  [[ "$newp" =~ ^[0-9]+$ ]] || die "PORT must be numeric"
  local dat="/srv/${name}/data"; local cfg="${dat}/config.json"
  [[ -d "$dat" ]] || die "Instance data dir not found: $dat"
  local host; host="$(json_get "$cfg" hostname)"; [[ -n "$host" ]] || host="127.0.0.1"
  local tmp; tmp="$(mktemp)"
  {
    echo "{"
    echo "  \"port\": ${newp},"
    echo "  \"hostname\": \"${host}\""
    echo "}"
  } > "$tmp"
  install -m 0644 "$tmp" "$cfg"; rm -f "$tmp"
  chown -R "$APP_USER:$APP_GROUP" "/srv/${name}"
  systemctl restart "${name}-budgetapp.service"
  log "instance set-port: ${name} -> ${newp}"
}

# Service wrappers
cmd_service() {
  require_root
  local inst="${1:-}" op="${2:-}"
  [[ -n "$inst" && -n "$op" ]] || die "Usage: actualctl service <INSTANCE> start|stop|restart|status"
  systemctl "$op" "${inst}-budgetapp.service"
}
cmd_logs() {
  local inst="${1:-}" lines="${2:-200}"
  [[ -n "$inst" ]] || die "Usage: actualctl logs <INSTANCE> [lines]"
  journalctl -u "${inst}-budgetapp.service" -n "$lines" --no-pager
}

# Perform a GET and only return the HTTP code (2–5s timeouts)
_curl_code() { curl -fsS -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 5 --insecure "$1" || true; }

# Check upstream (via Nginx) and backend (direct port) health
cmd_health() {
  local inst="${1:-}"
  local domain; domain="$(read_domain || true)"
  local rc=0

  # If no instance given, check all
  if [[ -z "$inst" ]]; then
    while IFS= read -r i; do
      cmd_health "$i" || rc=1
    done < <(discover_instances)
    [[ $rc -eq 0 ]] || return 1
    return 0
  fi

  local cfg="/srv/${inst}/data/config.json"
  local port; port="$(json_get "$cfg" port)"
  [[ -n "$port" ]] || { err "health: no port in $cfg"; return 1; }

  # Upstream via Nginx if domain known
  if [[ -n "$domain" ]]; then
    local host="${inst}-budgetapp.${domain}"
    local up="https://${host}/health/upstream"
    local code; code="$(_curl_code "$up")"
    if [[ "$code" == "200" ]]; then
      log "health: upstream OK (${inst}) 200 ${up}"
    else
      err "health: upstream FAIL (${inst}) code=${code:-NA} ${up}"
      rc=1
    fi
  else
    warn "health: domain not set in /etc/actual-budget/env; skipping upstream check for ${inst}"
  fi

  # Backend direct
  local be="http://127.0.0.1:${port}/"
  local bcode; bcode="$(_curl_code "$be")"
  if [[ "$bcode" == "200" || "$bcode" == "404" ]]; then
    log "health: backend OK (${inst}) code=${bcode} ${be}"
  else
    err "health: backend FAIL (${inst}) code=${bcode:-NA} ${be}"
    rc=1
  fi
  [[ $rc -eq 0 ]]
}

# A fuller diagnostic sweep: tools, nginx syntax, service state, ports, upstream
cmd_doctor() {
  require_root
  local ok=1

  # Tooling
  for c in node npm systemctl nginx curl ss; do
    command -v "$c" >/dev/null 2>&1 || { err "doctor: missing tool: $c"; ok=0; }
  done

  # Nginx config validity
  if nginx -t >/dev/null 2>&1; then
    log "doctor: nginx -t OK"
  else
    err "doctor: nginx -t FAILED"; ok=0
  fi

  # Per-instance checks
  while IFS= read -r inst; do
    local svc="${inst}-budgetapp.service"
    if systemctl is-active --quiet "$svc"; then
      log "doctor: service OK ${svc}"
    else
      err "doctor: service NOT ACTIVE ${svc}"; ok=0
    fi

    local cfg="/srv/${inst}/data/config.json"
    local port; port="$(json_get "$cfg" port)"
    if [[ -z "$port" ]]; then
      err "doctor: ${inst} missing port in ${cfg}"; ok=0
    else
      if ss -ltn | awk '{print $4}' | grep -q ":${port}$"; then
        log "doctor: port listen OK ${inst}:${port}"
      else
        err "doctor: port NOT LISTENING ${inst}:${port}"; ok=0
      fi
    fi
  done < <(discover_instances)

  # Upstreams
  if cmd_health >/dev/null; then
    log "doctor: upstream health OK"
  else
    err "doctor: upstream health FAILED"; ok=0
  fi

  [[ $ok -eq 1 ]] && log "doctor: OK" || { err "doctor: FAIL"; return 1; }
}

# ────────────────────────────────────────────────────────────────────────────────
# Dispatch
# ────────────────────────────────────────────────────────────────────────────────
case "${1:-}" in
  list)              shift; cmd_list "$@";;
  check)             shift; cmd_check "$@";;
  env)               shift; cmd_env "$@";;
  health)            shift; cmd_health "$@";;
  doctor)            shift; cmd_doctor "$@";;

  fetch)             shift; cmd_fetch "$@";;
  switch)            shift; cmd_switch "$@";;
  verify)            shift; cmd_verify "$@";;

  backup)            shift; cmd_backup "$@";;
  restore)           shift; cmd_restore "$@";;
  prune-backups)     shift; cmd_prune_backups "$@";;

  instance)          shift;
                     case "${1:-}" in
                       add)       shift; cmd_instance_add "$@";;
                       rm)        shift; cmd_instance_rm "$@";;
                       set-port)  shift; cmd_instance_set_port "$@";;
                       *)   err "Unknown: instance ${1:-}"; usage_quick; exit 2;;
                     esac
                     ;;

  service)           shift; cmd_service "$@";;
  logs)              shift; cmd_logs "$@";;

  *)                 err "Unknown command: ${1:-}"; usage_quick; exit 2;;
esac
