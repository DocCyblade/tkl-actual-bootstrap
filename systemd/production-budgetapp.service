[Unit]
Description=Actual Budget Sync Server (production)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=budget-server
Group=budget-server
WorkingDirectory=/srv/app/production
Environment=PATH=/srv/app/production/node_modules/.bin:/usr/local/bin:/usr/bin
Environment=NODE_ENV=production
Environment=ACTUAL_DATA_DIR=/srv/production/data
ExecStart=/srv/app/production/node_modules/.bin/actual-server
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/production/data

[Install]
WantedBy=multi-user.target